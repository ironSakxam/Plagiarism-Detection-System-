{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build and run plagiarism project",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "& { .\\build.bat; if ($LASTEXITCODE -eq 0) { .\\plagiarism.exe } }"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}